{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Dev Server",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev"
        },
        {
            "name": "Launch Chrome",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5173/atomic-habits/",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "Start Dev Server"
        },
        {
            "name": "Launch Edge",
            "type": "msedge",
            "request": "launch",
            "url": "http://localhost:5173/atomic-habits/",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "Start Dev Server"
        },
        {
            "name": "Launch Chrome (Existing Server)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5173/atomic-habits/",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Run npm start",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm start"
        }
    ]
}